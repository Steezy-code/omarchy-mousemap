#!/usr/bin/env bash
# MouseMap's only path to the filesystem and the compositor.
#
# The panel owns all the logic — which buttons exist, what they should do,
# what Lua that becomes. This script exists for the three things QML cannot
# do safely on its own: gather the two inputs discovery needs in a single
# round trip, put bytes on disk atomically, and poke Hyprland.
#
# Every write lands by rename(2) into the same directory, so a reader either
# sees the old file or the complete new one, never a half-written config.
# Nothing is written through a symlink.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-mousemap"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/mousemap.json"
BINDINGS_LUA="$STATE_DIR/bindings.lua"
HYPR_BINDINGS="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"

# What the DPI presets compiled to, written beside bindings.lua by the same
# Apply, and which preset each device is currently on.
DPI_SIDECAR="$STATE_DIR/dpi.json"
DPI_ACTIVE="$STATE_DIR/dpi-active"

# Refuse anything absurd rather than streaming it into the panel.
MAX_BYTES=1048576

die() { printf 'mousemap: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers

# stdin -> path, atomically. The temp file is a sibling so the rename stays
# on one filesystem and is therefore atomic.
cmd_write() {
  local path="${1:-}"
  [ -n "$path" ] || die "write: no path"
  [ -L "$path" ] && die "write: $path is a symlink"

  local dir
  dir="$(dirname "$path")"
  mkdir -p "$dir"

  local tmp
  tmp="$(mktemp "$dir/.mousemap.XXXXXXXX")"
  # Any failure from here on must not leave the stage behind.
  trap 'rm -f "$tmp"' EXIT
  cat >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$path"
  trap - EXIT
}

cmd_read() {
  local path="${1:-}"
  [ -n "$path" ] || die "read: no path"
  [ -e "$path" ] || return 0          # missing is empty, not an error
  [ -L "$path" ] && die "read: $path is a symlink"
  [ -f "$path" ] || die "read: $path is not a regular file"
  head -c "$MAX_BYTES" -- "$path"
}

# One-time snapshot of the user's own bindings.lua, taken before we ever
# add our loader line to it. Never overwritten, so it always represents the
# file as it was before this plugin touched anything.
cmd_backup() {
  local path="${1:-$HYPR_BINDINGS}"
  local backup="$path.mousemap.bak"
  [ -f "$path" ] || return 0
  [ -e "$backup" ] && return 0
  cp -p -- "$path" "$backup"
  printf '%s\n' "$backup"
}

# ---------------------------------------------------------------- discovery

# Both inputs the panel's discovery needs, as one JSON envelope, so the
# panel makes a single Process call instead of racing two.
#
# /proc/bus/input/devices carries vendor:product and the evdev capability
# bitmaps; hyprctl carries the name a device-scoped bind must use. Neither
# alone is enough.
cmd_detect() {
  local proc="" hypr=""
  [ -r /proc/bus/input/devices ] && proc="$(head -c "$MAX_BYTES" /proc/bus/input/devices)"
  hypr="$(hyprctl devices -j 2>/dev/null || echo '{}')"

  # Encode with python so the bitmaps and quotes survive intact. The same
  # pass collects wireless-mouse batteries: the kernel's HID++ driver
  # publishes them under /sys/class/power_supply with scope=Device, and
  # each one's `device` link points at the very HID node the input device
  # hangs off — so they can be matched to a mouse by path rather than by
  # guessing from a name.
  PROC="$proc" HYPR="$hypr" python3 -c '
import json, os, glob

def read(path):
    try:
        with open(path) as handle:
            return handle.read().strip()
    except OSError:
        return ""

batteries = []
for entry in sorted(glob.glob("/sys/class/power_supply/*")):
    # Device-scoped supplies are peripherals; anything else is the laptop.
    if read(os.path.join(entry, "scope")) != "Device":
        continue
    try:
        target = os.path.realpath(os.path.join(entry, "device"))
    except OSError:
        target = ""
    # Paths are compared against the input device sysfs path, which is
    # rooted at /devices, so drop the /sys prefix here.
    if target.startswith("/sys"):
        target = target[4:]
    batteries.append({
        "id": os.path.basename(entry),
        "model": read(os.path.join(entry, "model_name")),
        "manufacturer": read(os.path.join(entry, "manufacturer")),
        "capacity": read(os.path.join(entry, "capacity")),
        "level": read(os.path.join(entry, "capacity_level")),
        "status": read(os.path.join(entry, "status")),
        "serial": read(os.path.join(entry, "serial_number")),
        "online": read(os.path.join(entry, "online")),
        "path": target,
    })

print(json.dumps({
    "proc": os.environ.get("PROC", ""),
    "hypr": os.environ.get("HYPR", "{}"),
    "batteries": batteries,
}))
'
}

# ---------------------------------------------------------------- apply

cmd_reload() {
  hyprctl reload >/dev/null 2>&1 || die "hyprctl reload failed"
  local errors
  errors="$(hyprctl configerrors 2>/dev/null || true)"
  # Hyprland prints a "no errors" sentinel rather than nothing at all.
  if [ -n "$errors" ] && ! printf '%s' "$errors" | grep -qi 'no errors'; then
    printf '%s\n' "$errors"
    exit 2
  fi
}

# Load the generated bindings into the running compositor without a full
# reload, for previewing a change. The file guards every bind with an
# unbind, so re-running it is safe.
cmd_live() {
  [ -f "$BINDINGS_LUA" ] || die "live: nothing generated yet"
  hyprctl eval "pcall(dofile, \"$BINDINGS_LUA\")" >/dev/null 2>&1 || die "hyprctl eval failed"
}

# ---------------------------------------------------------------- learn
#
# Behind a Logitech receiver the evdev capability bitmap describes the
# dongle, not the mouse: it claims all sixteen BTN_MOUSE codes and a full
# keyboard whatever is actually paired. The only way to know which buttons
# a mouse really has is to watch the user press them.
#
# Reading the events directly would mean opening /dev/input/event*, which
# needs the `input` group a desktop user does not have. So we ask the
# compositor instead: bind every candidate code to a line in a log, and see
# which ones ever fire. No permissions, no daemon.
#
# Left and right click are deliberately left alone. Grabbing them would
# leave the user unable to click the panel telling them to press buttons.
LEARN_LOG="$STATE_DIR/learn.log"
LEARN_CODES="274 275 276 277 278 279 280 281 282 283 284 285 286 287"

# Trigger ids match Devices.js: a mouse button is its own code, a keystroke
# is 4096 + the xkb keycode.
KEY_BASE=4096

cmd_learn() {
  case "${1:-}" in
    arm)
      mkdir -p "$STATE_DIR"
      : >"$LEARN_LOG"
      local lua=""
      for code in $LEARN_CODES; do
        lua+="pcall(hl.unbind, \"mouse:$code\") "
        lua+="hl.bind(\"mouse:$code\", function() "
        lua+="hl.dispatch(hl.dsp.exec_cmd(\"sh -c 'echo $code >> $LEARN_LOG'\")) "
        lua+="end, { description = \"MouseMap learn $code\" }) "
      done

      # A mouse whose onboard profile assigns a button a keystroke sends it
      # from the receiver's keyboard interface, so it never appears as a
      # mouse button and a mouse-only probe cannot see it at all.
      #
      # Watching for it means binding keys — which is only safe because
      # every one of these is scoped to the mouse's own keyboard device.
      # The real keyboard is untouched, which is what makes it acceptable
      # to grab a range this wide, modifiers included.
      local kbd="${2:-}"
      if [ -n "$kbd" ]; then
        local kc
        for kc in $(seq 9 250); do
          lua+="pcall(hl.unbind, \"code:$kc\") "
          lua+="hl.bind(\"code:$kc\", function() "
          lua+="hl.dispatch(hl.dsp.exec_cmd(\"sh -c 'echo \$(( $KEY_BASE + $kc )) >> $LEARN_LOG'\")) "
          lua+="end, { description = \"MouseMap learn key $kc\", "
          lua+="device = { inclusive = true, list = { \"$kbd\" } } }) "
        done
      fi

      hyprctl eval "$lua" >/dev/null 2>&1 || die "learn: hyprctl eval failed"

      # Report how many probes the compositor actually took. A silent zero
      # here is indistinguishable from "the user has not pressed anything
      # yet", which is the worst possible failure for a screen whose only
      # instruction is to press something.
      hyprctl binds -j 2>/dev/null \
        | grep -c 'MouseMap learn' \
        || echo 0
      ;;
    read)
      [ -f "$LEARN_LOG" ] && sort -un "$LEARN_LOG" || true
      ;;
    raw)
      # Every press in order, repeats included. The guided pass wants the
      # unique set; the placement test wants each individual press, so it
      # can light a button up again every time you hit it.
      [ -f "$LEARN_LOG" ] && cat "$LEARN_LOG" || true
      ;;
    disarm)
      # A reload rebuilds every bind from the config files, which drops the
      # probes and restores whatever the user actually has mapped.
      rm -f "$LEARN_LOG"
      hyprctl reload >/dev/null 2>&1 || true
      ;;
    *) die "learn: expected arm, read, raw, or disarm" ;;
  esac
}

# ---------------------------------------------------------------- dpi
#
# Switching a DPI preset happens entirely inside the generated Lua: the
# sensitivity tables are already there, so a press is one hl.device call
# with nothing to spawn and nothing to compute.
#
# This is the slow half, dispatched afterwards — remember which preset was
# chosen so it survives a reload, and say so on screen. It is deliberately
# given nothing but two integers, because those integers are generated by
# the panel and every string they stand for is looked up here rather than
# passed across a command line.

# nf-md-mouse. The OSD renders whatever glyph it is handed for a name it
# does not recognise, and an empty icon would draw the volume glyph.
DPI_ICON=$'\U000f037d'

cmd_dpi() {
  case "${1:-}" in
    note)    shift; dpi_note "$@" ;;
    preview) dpi_preview ;;
    status)  dpi_status ;;
    *) die "dpi: expected note, preview, or status" ;;
  esac
}

# Record slot -> preset, and announce it.
dpi_note() {
  local slot="${1:-}" index="${2:-}"
  # Both come from generated Lua, so anything else is a bug or a probe.
  [[ "$slot" =~ ^[0-9]{1,3}$ && "$index" =~ ^[0-9]{1,3}$ ]] || die "dpi note: expected two small integers"

  mkdir -p "$STATE_DIR"

  local message
  message="$(SLOT="$slot" INDEX="$index" ACTIVE="$DPI_ACTIVE" SIDECAR="$DPI_SIDECAR" python3 -c '
import json, os, sys, tempfile

slot = int(os.environ["SLOT"])
index = int(os.environ["INDEX"])
active_path = os.environ["ACTIVE"]

# Rewrite the whole file rather than appending: an append-only log would
# grow without bound and leave the loader reading the first match.
rows = {}
try:
    with open(active_path) as handle:
        for line in handle:
            parts = line.rstrip("\n").split("\t")
            if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
                rows[int(parts[0])] = int(parts[1])
except OSError:
    pass
rows[slot] = index

directory = os.path.dirname(active_path)
handle, staged = tempfile.mkstemp(dir=directory, prefix=".dpi-active.")
with os.fdopen(handle, "w") as out:
    for key in sorted(rows):
        out.write("%d\t%d\n" % (key, rows[key]))
os.chmod(staged, 0o644)
os.replace(staged, active_path)

# The label is looked up, never passed in, so a preset name can be any
# text at all without ever reaching a command line.
try:
    with open(os.environ["SIDECAR"]) as handle:
        sidecar = json.load(handle)
    preset = sidecar["devices"][slot - 1]["presets"][index - 1]
    sys.stdout.write("%s · %d DPI" % (preset["name"], preset["dpi"]))
except Exception:
    pass
')"

  # Best effort: the OSD lives in a plugin the user is free to switch off,
  # and a missing overlay is no reason to fail a DPI switch.
  if [ -n "$message" ] && command -v omarchy >/dev/null 2>&1; then
    omarchy osd -i "$DPI_ICON" -m "$message" >/dev/null 2>&1 || true
  fi
}

# Apply one sensitivity to one device, now, without touching any file.
# This is what makes dragging the slider in the panel feel like something;
# nothing is persisted until Apply.
#
# The request arrives on stdin as JSON so that neither the device name nor
# the number is ever a shell word.
dpi_preview() {
  local lua
  lua="$(head -c 4096 | python3 -c '
import json, sys

def lua_string(value):
    out = []
    for char in value:
        point = ord(char)
        if char == "\\": out.append("\\\\")
        elif char == "\"": out.append("\\\"")
        elif char == "\n": out.append("\\n")
        elif char == "\r": out.append("\\r")
        elif char == "\t": out.append("\\t")
        elif point < 0x20 or point == 0x7f: out.append("\\%d" % point)
        else: out.append(char)
    return "\"" + "".join(out) + "\""

try:
    request = json.load(sys.stdin)
    name = request["device"]
    sensitivity = float(request["sensitivity"])
except Exception:
    sys.exit("dpi preview: expected {\"device\": ..., \"sensitivity\": ...}")

if not isinstance(name, str) or not name or len(name) > 128:
    sys.exit("dpi preview: implausible device name")
# libinput refuses anything outside this, and Hyprland passes it straight
# through.
if not (-1.0 <= sensitivity <= 1.0):
    sys.exit("dpi preview: sensitivity out of range")

print("hl.device({ name = %s, accel_profile = \"flat\", sensitivity = %.6f })"
      % (lua_string(name), sensitivity))
')" || exit 1

  hyprctl eval "$lua" >/dev/null 2>&1 || die "dpi preview: hyprctl eval failed"
}

# What the runtime has, for the panel to read back on open: the presets it
# generated, plus which one each device is actually on right now.
dpi_status() {
  SIDECAR="$DPI_SIDECAR" ACTIVE="$DPI_ACTIVE" python3 -c '
import json, os

try:
    with open(os.environ["SIDECAR"]) as handle:
        sidecar = json.load(handle)
except Exception:
    sidecar = {"version": 1, "devices": []}

active = {}
try:
    with open(os.environ["ACTIVE"]) as handle:
        for line in handle:
            parts = line.rstrip("\n").split("\t")
            if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
                active[parts[0]] = int(parts[1])
except OSError:
    pass

for slot, device in enumerate(sidecar.get("devices", []), start=1):
    chosen = active.get(str(slot))
    presets = device.get("presets", [])
    # A state file naming a preset that has since been deleted is stale,
    # and the generated Lua ignores it the same way.
    if chosen is None or not (1 <= chosen <= len(presets)):
        chosen = device.get("active", 0) + 1
    device["current"] = chosen - 1

print(json.dumps(sidecar))
'
}

# Float and size the panel window.
#
# A `float` window rule would be the obvious way to do this and it does not
# work: Hyprland evaluates rules when the window maps, and Quickshell sets
# the title a moment later, so a title match never sees it. Matching the
# class instead would catch every Quickshell toplevel on the system, not
# just ours.
#
# So the window is floated by address after it appears. Only a window that
# is currently tiled is touched, which leaves a user who deliberately tiled
# it alone.
PANEL_TITLE_PREFIX="MouseMap"
PANEL_W=1180
PANEL_H=780

cmd_float() {
  local address
  address="$(hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
prefix = sys.argv[1]
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for client in clients:
    if str(client.get("title", "")).startswith(prefix) and not client.get("floating"):
        print(client.get("address", ""))
        break
' "$PANEL_TITLE_PREFIX")"

  [ -n "$address" ] || return 0

  # Omarchy drives Hyprland from Lua, so `hyprctl dispatch` takes Lua, not
  # the legacy "setfloating address:0x..." string form — that parses as Lua
  # and fails. Same shape as hypr/popout.lua, which does this for real.
  # Forced opaque because Omarchy tags every window for its default
  # translucency, and a diagram read against whatever happens to be behind
  # it is a diagram you cannot read. `opaque` takes 1, not true — a boolean
  # is rejected as a missing value.
  hyprctl eval "
local target = \"address:$address\"
hl.dispatch(hl.dsp.window.float({ window = target, action = \"on\" }))
hl.dispatch(hl.dsp.window.resize({ window = target, x = $PANEL_W, y = $PANEL_H }))
hl.dispatch(hl.dsp.window.center({ window = target }))
hl.dispatch(hl.dsp.window.set_prop({ window = target, prop = \"opaque\", value = 1 }))
" >/dev/null 2>&1 || true
}

cmd_paths() {
  python3 -c '
import json, sys
print(json.dumps({
  "config": sys.argv[1], "bindings": sys.argv[2],
  "hyprBindings": sys.argv[3], "stateDir": sys.argv[4],
}))
' "$CONFIG" "$BINDINGS_LUA" "$HYPR_BINDINGS" "$STATE_DIR"
}

cmd_status() {
  printf 'config      %s %s\n' "$CONFIG" "$([ -f "$CONFIG" ] && echo '(present)' || echo '(none)')"
  printf 'bindings    %s %s\n' "$BINDINGS_LUA" "$([ -f "$BINDINGS_LUA" ] && echo '(present)' || echo '(none)')"
  printf 'hook        %s\n' "$(grep -q 'BEGIN mousemap' "$HYPR_BINDINGS" 2>/dev/null && echo 'installed' || echo 'not installed')"
  if [ -f "$BINDINGS_LUA" ]; then
    printf 'live binds  %s\n' "$(hyprctl binds -j 2>/dev/null | grep -c 'MouseMap:' || echo 0)"
  fi
  if [ -f "$DPI_SIDECAR" ]; then
    dpi_status | python3 -c '
import json, sys

try:
    payload = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for device in payload.get("devices", []):
    presets = device.get("presets", [])
    current = device.get("current", 0)
    name = presets[current]["name"] if 0 <= current < len(presets) else "?"
    dpi = presets[current]["dpi"] if 0 <= current < len(presets) else "?"
    print("dpi         %s  %s DPI (%s), %d preset%s, sensor %s DPI"
          % (device.get("name", "?"), dpi, name, len(presets),
             "" if len(presets) == 1 else "s", device.get("base", "?")))
'
  fi
}

# ---------------------------------------------------------------- dispatch

case "${1:-}" in
  write)   shift; cmd_write "$@" ;;
  read)    shift; cmd_read "$@" ;;
  backup)  shift; cmd_backup "$@" ;;
  detect)  cmd_detect ;;
  reload)  cmd_reload ;;
  live)    cmd_live ;;
  float)   cmd_float ;;
  learn)   shift; cmd_learn "$@" ;;
  dpi)     shift; cmd_dpi "$@" ;;
  paths)   cmd_paths ;;
  status)  cmd_status ;;
  *)
    cat >&2 <<'USAGE'
usage: mousemap <command>

  detect            gather /proc + hyprctl input state as JSON
  read <path>       print a file, bounded and symlink-refusing
  write <path>      install stdin at path, atomically
  backup [path]     one-time snapshot of hypr/bindings.lua
  reload            hyprctl reload, failing loudly on config errors
  live              load generated bindings into the running compositor
  float             float and size the panel window
  learn arm|read|raw|disarm
                    watch which buttons the mouse actually has
  dpi note <slot> <preset>
                    remember a DPI switch and show it on screen
  dpi preview       apply one sensitivity live, from JSON on stdin
  dpi status        the generated DPI presets and the current one, as JSON
  paths             the paths this plugin uses, as JSON
  status            what is installed and how many binds are live
USAGE
    exit 1 ;;
esac
