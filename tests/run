#!/usr/bin/env bash
# Every test, in one command.
#
# There is no framework on purpose. Each file is plain `node` plus the real
# `lua` and `luac` binaries, because the failures worth catching here are in
# what the compositor executes, not in JavaScript.

set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

for tool in node lua luac; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "tests: $tool is not installed" >&2
    exit 1
  }
done

failed=0
for test in tests/test_*.js; do
  printf '\n\033[1m%s\033[0m\n' "$test"
  node "$test" || failed=1
done

printf '\n'
if (( failed )); then
  echo "FAILED"
  exit 1
fi
echo "All tests passed."
